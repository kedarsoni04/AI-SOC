# ============================================================
# AI-SOC Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development          # development | production
APP_SECRET_KEY=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY_HERE
DEBUG=true

# --- Database ---
# For Docker Compose (default):
DATABASE_URL=postgresql+asyncpg://socsysuser:socsyspass@localhost:5432/aisoc
# For local dev without Docker (SQLite fallback):
# DATABASE_URL=sqlite+aiosqlite:///./aisoc_dev.db

POSTGRES_USER=socsysuser
POSTGRES_PASSWORD=socsyspass
POSTGRES_DB=aisoc

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET_FOR_JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI / LLM ---
# Provider: gemini | openai | anthropic | none
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Simulation ---
SIMULATION_EVENTS_PER_SECOND=2
SIMULATION_ATTACK_INTENSITY=medium    # low | medium | high

# --- ML ---
ML_MODEL_PATH=./ml/models
ML_RETRAIN_ON_STARTUP=false

# --- Threat Intelligence ---
# External TI provider (optional — leave blank for internal-only)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- AWS (for deployment) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ECR_REGISTRY=
AWS_ECS_CLUSTER=ai-soc-cluster

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
